<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_student_details" model="ir.actions.report">
        <field name="name">Student Details</field>
        <field name="model">student.information</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_student_details</field>
        <field name="report_file">school_management.report_student_details</field>
        <field name="print_report_name">
            'Student - %s' % (object.roll_number)
        </field>
        <field name="binding_model_id" ref="model_student_information"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_student_details">
        <t t-foreach="docs" t-as="student">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h4 class="text-center font-bold">Student Details</h4>
                    </div>
                    <p>Name:
                        <t t-esc="student.name"/>
                    </p>
                    <p>Email:
                        <t t-esc="student.email"/>
                    </p>
                    <p>Phone:
                        <t t-esc="student.phone_number"/>
                    </p>
                    <p>Class:
                        <t t-esc="student.class_id.name"/>
                    </p>
                    <p>Address:
                        <t t-esc="student.address"/>
                    </p>
                </t>
            </t>

        </t>
    </template>
</odoo>